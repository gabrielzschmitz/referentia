// src/app/application.rc
GLFW_ICON ICON "../../resources/icon.ico"

1 VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"    // English US
    BEGIN
      VALUE "FileDescription", "Referentia - a cross-platform visual reference canvas"
      VALUE "FileVersion", "0.1.0"
      VALUE "InternalName", "Referentia"
      VALUE "OriginalFilename", "referentia.exe"
      VALUE "ProductName", "Referentia"
      VALUE "ProductVersion", "0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252    // English US
  END
END
